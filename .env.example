# Firebase Realtime Database ( web config — public identifiers )
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# PayPal. VITE_PAYPAL_CLIENT_ID is public. PAYPAL_CLIENT_SECRET stays on the server
# and is required before a PayPal payment can be marked paid.
VITE_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Google reCAPTCHA v2 ("I'm not a robot"). Site key is public. Secret stays server-only.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Cardnet API Consulta + 3DS (server-only — never prefix with VITE_)
CARDNET_ENV=lab
CARDNET_MERCHANT_NUMBER=349000000
CARDNET_MERCHANT_TERMINAL=58585858
CARDNET_MERCHANT_TERMINAL_AMEX=00000001
CARDNET_MERCHANT_TYPE=7997
CARDNET_ACQUIRING_INSTITUTION_CODE=349
CARDNET_MERCHANT_NAME=ERSUNNY TRAVEL
# Card charges are always DOP (214). Site prices stay in USD.
CARDNET_CURRENCY_CODE=214
# Pesos per 1 US dollar. Update when the rate changes. Same number in both.
CARDNET_USD_DOP_RATE=61.45
VITE_USD_DOP_RATE=61.45
CARDNET_AVS=PUNTA CANA DOMINICAN REPUBLIC
CARDNET_STATE_SECRET=change-me-to-a-long-random-string

# Cloudinary media library (server-only — never prefix the secret with VITE_)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin login by email code (Resend). SESSION_SECRET must be at least 16 characters.
RESEND_API_KEY=
RESEND_FROM=Ersunny Travel <admin@yourdomain.com>
ADMIN_EMAILS=admin@example.com
SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Google often blocks creating a private key for the Firebase admin
# account. Media is stored in Cloudinary, and login codes work without this key.
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_JSON=
